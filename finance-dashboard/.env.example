# Copy to .env and fill in. Never commit .env.

# Plaid credentials: https://dashboard.plaid.com/developers/keys
PLAID_CLIENT_ID=
PLAID_SECRET=
# sandbox (fake test banks) or production (your real accounts)
PLAID_ENV=sandbox

# 64 hex characters (32 bytes) used to encrypt bank access tokens on disk.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TOKEN_ENCRYPTION_KEY=

# Server binds to localhost only. Change the port if needed.
PORT=3000

# Set to 1 to run with sample data and no Plaid connection.
DEMO=0
